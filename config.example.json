{
  "signal": {
    "daemonUrl": "http://127.0.0.1:8080",
    "account": "+15551234567",
    "allowedSenders": ["+15557654321"]
  },
  "repositories": {
    "pocket-agent": "/Users/you/code/pocket-agent",
    "website": "/Users/you/code/website"
  },
  "stateDir": "~/.local/share/pocket-agent",
  "sandbox": {
    "runner": "docker",
    "dockerPath": "/usr/local/bin/docker",
    "image": "pocket-agent/worker@sha256:PIN_THE_BUILT_IMAGE_DIGEST",
    "cpus": 1,
    "memoryBytes": 1073741824,
    "pids": 256,
    "temporaryStorageBytes": 268435456,
    "workspaceStorageBytes": 805306368
  },
  "agent": {
    "model": "anthropic/claude-sonnet-4-5",
    "apiKeyEnv": "ANTHROPIC_API_KEY",
    "modelRequestTimeoutMs": 120000,
    "modelMaxRequestsPerMinute": 10,
    "modelMaxTokensPerRequest": 32000,
    "modelMaxTokensPerJob": 200000,
    "thinking": "medium",
    "permissions": {
      "read": "allow",
      "write": "ask",
      "bash": "ask"
    }
  }
}
